{
  "name": "captureflow",
  "private": true,
  "version": "0.1.0",
  "description": "CaptureFlow — open-source, self-hostable screen recording with instant shareable links.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.30.0",
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "build": "nx run-many -t build",
    "dev": "nx run-many -t dev --parallel=5",
    "web": "pnpm --filter @captureflow/web dev",
    "extension": "pnpm --filter @captureflow/extension dev",
    "extension:build": "pnpm --filter @captureflow/extension build",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "graph": "nx graph",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,jsonc,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,jsonc,css}\"",
    "scan:secrets": "gitleaks git . --config .gitleaks.toml --redact --no-banner",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "nx": "22.6.0",
    "png-to-ico": "^3.0.1",
    "prettier": "^3.4.2",
    "sharp": "^0.35.1",
    "typescript": "catalog:",
    "wrangler": "4.142.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "sharp",
      "workerd",
      "uiohook-napi",
      "koffi",
      "ffmpeg-static",
      "nx"
    ],
    "overrides": {
      "drizzle-orm": "0.45.3",
      "undici@<7": "6.29.0",
      "undici@>=7 <8": "7.30.0",
      "brace-expansion@<2": "1.1.21",
      "brace-expansion@>=2 <3": "2.1.7",
      "brace-expansion@>=3 <6": "5.0.12",
      "js-yaml@<4": "3.15.2",
      "js-yaml@>=4 <5": "4.3.2",
      "tar": "7.5.22",
      "dompurify": "3.4.16",
      "fast-uri@<4": "3.1.8",
      "nx": "22.7.12",
      "postcss": "8.5.28",
      "nanoid@<4": "3.3.19",
      "browserslist": "4.29.1",
      "qs": "6.16.0",
      "@xmldom/xmldom@<0.9": "0.8.15",
      "fflate@<0.5": "0.4.9",
      "vitest": "4.1.11",
      "@vitest/mocker": "4.1.11",
      "baseline-browser-mapping": "2.11.26",
      "sharp": "0.35.5",
      "adm-zip": "0.6.1",
      "shell-quote": "1.10.0",
      "esbuild@<0.25": "0.25.12",
      "esbuild@>=0.27 <0.29": "0.28.1",
      "uuid@<11.1.1": "11.1.1",
      "smol-toml@<=1.7.0": "1.7.1",
      "tmp@<0.2.7": "0.2.7",
      "vite": "7.3.5"
    }
  }
}
